<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\heydanis.ico</ApplicationIcon>
    <AssemblyName>heyDanis</AssemblyName>
    <RootNamespace>HeyDanis.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HeyDanis.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\heydanis.ico" LogicalName="HeyDanis.App.Assets.heydanis.ico" />
    <Resource Include="Assets\heydanis.ico" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\HeyDanis.Companion\HeyDanis.Companion.csproj" />
    <ProjectReference Include="..\HeyDanis.Audio\HeyDanis.Audio.csproj" />
    <ProjectReference Include="..\HeyDanis.Capture\HeyDanis.Capture.csproj" />
    <ProjectReference Include="..\HeyDanis.Hotkey\HeyDanis.Hotkey.csproj" />
    <ProjectReference Include="..\HeyDanis.Overlay\HeyDanis.Overlay.csproj" />
    <ProjectReference Include="..\HeyDanis.Api\HeyDanis.Api.csproj" />
    <ProjectReference Include="..\HeyDanis.Pointing\HeyDanis.Pointing.csproj" />
  </ItemGroup>

</Project>
