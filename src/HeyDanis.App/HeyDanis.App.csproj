<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HeyDanis.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HeyDanis.Companion\HeyDanis.Companion.csproj" />
    <ProjectReference Include="..\HeyDanis.Audio\HeyDanis.Audio.csproj" />
    <ProjectReference Include="..\HeyDanis.Capture\HeyDanis.Capture.csproj" />
    <ProjectReference Include="..\HeyDanis.Hotkey\HeyDanis.Hotkey.csproj" />
    <ProjectReference Include="..\HeyDanis.Overlay\HeyDanis.Overlay.csproj" />
    <ProjectReference Include="..\HeyDanis.Api\HeyDanis.Api.csproj" />
    <ProjectReference Include="..\HeyDanis.Pointing\HeyDanis.Pointing.csproj" />
  </ItemGroup>

</Project>
