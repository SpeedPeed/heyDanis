<Window x:Class="HeyDanis.App.TextQuestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/heydanis.ico"
        Title="heyDanis – Frage tippen"
        Width="460" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Border Background="#F01C1C1E"
            BorderBrush="#FF6A2B"
            BorderThickness="1.5"
            CornerRadius="12"
            Padding="14,12,14,10">
        <StackPanel>
            <TextBlock Text="Frag heyDanis (Enter = senden, Esc = abbrechen)"
                       FontSize="11"
                       Foreground="#8E8E93"
                       Margin="0,0,0,8" />
            <TextBox x:Name="QuestionBox"
                     FontSize="14"
                     Foreground="#F5F5F7"
                     Background="#2C2C2E"
                     BorderBrush="#48484A"
                     BorderThickness="1"
                     Padding="8,6"
                     CaretBrush="#F5F5F7"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     MaxHeight="160"
                     VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="QuestionBox_PreviewKeyDown" />
            <TextBlock Text="Shift+Enter = neue Zeile · der Bildschirm wird beim Senden mitgeschickt"
                       FontSize="10"
                       Foreground="#636366"
                       Margin="0,6,0,0" />
        </StackPanel>
    </Border>
</Window>
