<Window x:Class="HeyDanis.App.SettingsWindow"
        Icon="Assets/heydanis.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:companion="clr-namespace:HeyDanis.Companion;assembly=HeyDanis.Companion"
        xmlns:local="clr-namespace:HeyDanis.App"
        Title="heyDanis – Einstellungen"
        Width="480" Height="820"
        MinWidth="400" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#1C1C1E"
        Foreground="#F5F5F7"
        ResizeMode="CanResize">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#1C1C1E" />
        <SolidColorBrush x:Key="CardBackground" Color="#262628" />
        <SolidColorBrush x:Key="BorderSubtle" Color="#2C2C2E" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F7" />
        <SolidColorBrush x:Key="TextSecondary" Color="#C7C7CC" />
        <SolidColorBrush x:Key="TextTertiary" Color="#8E8E93" />
        <SolidColorBrush x:Key="Success" Color="#34C759" />
        <SolidColorBrush x:Key="Failure" Color="#FF453A" />
        <SolidColorBrush x:Key="Accent" Color="#FF6A2B" />
        <SolidColorBrush x:Key="InputBackground" Color="#38383A" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Converts non-null to Visible, null to Collapsed -->
        <local:NullToVisibilityConverter x:Key="NullToCollapsed" />

        <!-- Rounded button style -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TestButton" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   TextDecorations="Underline" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ComboBox dark style. Windows 11's default ComboBox template ignores Background
            and paints a white box (white text on white = unreadable), so we replace the
            whole template: dark toggle area, dark drop-down, orange highlight.
        -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#4A4A4D" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#5A3A2A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Data="M 0 0 L 4 4 L 8 0" Stroke="#C7C7CC" StrokeThickness="1.5" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#FF6A2B" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#2C2C2E"
                                        BorderBrush="#48484A"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox dark style -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        </Style>

        <!-- PasswordBox dark style -->
        <Style x:Key="DarkPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,20">

            <!-- Header -->
            <TextBlock x:Name="HeaderText"
                       Text="Einstellungen"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,20" />

            <!-- LLM Model -->
            <TextBlock Text="KI-MODELL"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextTertiary}"
                       Margin="0,0,0,6" />
            <TextBlock Text="Haiku kostet nur Bruchteile eines Cents pro Frage. Sonnet ist genauer, aber rund 20-mal teurer."
                       FontSize="11"
                       Foreground="{StaticResource TextTertiary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <ComboBox x:Name="ModelCombo"
                      Style="{StaticResource DarkComboBox}"
                      ItemsSource="{Binding AvailableModels}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedModel, Mode=TwoWay}"
                      Margin="0,0,0,20" />

            <!-- Separator -->
            <Border Height="0.5" Background="{StaticResource BorderSubtle}" Margin="0,0,0,20" />

            <!-- API KEYS header -->
            <TextBlock Text="API-KEYS"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextTertiary}"
                       Margin="0,0,0,12" />

            <!-- Anthropic API Key -->
            <Grid Margin="0,0,0,4">
                <TextBlock Text="Anthropic"
                           FontSize="13" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" />
                <Button Content="Key holen &#x2192;"
                        Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Right"
                        Click="AnthropicLink_Click" />
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Password field (visible when key is NOT saved as placeholder) -->
                <PasswordBox x:Name="AnthropicKeyBox"
                             Grid.Column="0"
                             Style="{StaticResource DarkPasswordBox}"
                             PasswordChanged="AnthropicKeyBox_PasswordChanged"
                             Margin="0,0,8,0" />
                <!-- Saved placeholder (visible when key IS saved) -->
                <TextBox x:Name="AnthropicSavedPlaceholder"
                         Grid.Column="0"
                         Style="{StaticResource DarkTextBox}"
                         Text="&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;"
                         IsReadOnly="True"
                         Margin="0,0,8,0"
                         Visibility="Collapsed" />
                <Button x:Name="AnthropicChangeBtn"
                        Grid.Column="1"
                        Content="Ändern"
                        Style="{StaticResource TestButton}"
                        Click="AnthropicChange_Click"
                        Visibility="Collapsed"
                        Margin="0,0,8,0" />
                <Button x:Name="AnthropicTestBtn"
                        Grid.Column="2"
                        Content="Test"
                        Style="{StaticResource TestButton}"
                        Click="AnthropicTest_Click" />
            </Grid>

            <!-- Anthropic key error -->
            <TextBlock Text="{Binding AnthropicKeyError}"
                       FontSize="11" Foreground="{StaticResource Failure}"
                       Margin="0,0,0,4"
                       TextWrapping="Wrap"
                       Visibility="{Binding AnthropicKeyError, Converter={StaticResource NullToCollapsed}}" />
            <!-- Result of the "Test" button, so the reason is visible without hovering -->
            <TextBlock Text="{Binding AnthropicTestError}"
                       FontSize="11" Foreground="{StaticResource Failure}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"
                       Visibility="{Binding AnthropicTestError, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock Text="✓ Key funktioniert"
                       FontSize="11" Foreground="{StaticResource Success}"
                       Margin="0,0,0,4"
                       Visibility="{Binding AnthropicTestSucceeded, Converter={StaticResource BoolToVis}}" />

            <!-- Separator -->
            <Border Height="0.5" Background="{StaticResource BorderSubtle}" Margin="0,8,0,16" />

            <!-- SPEECH section -->
            <TextBlock Text="SPRACHE &amp; STIMME"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextTertiary}"
                       Margin="0,0,0,6" />
            <TextBlock Text="„Lokal“ läuft komplett auf deinem PC und kostet nichts. Beim ersten Start werden die Modelle einmalig heruntergeladen."
                       FontSize="11"
                       Foreground="{StaticResource TextTertiary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <TextBlock Text="Spracherkennung"
                       FontSize="13" FontWeight="Medium"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,0,0,6" />
            <ComboBox Style="{StaticResource DarkComboBox}"
                      ItemsSource="{Binding SpeechRecognitionChoices}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedSpeechRecognitionId, Mode=TwoWay}"
                      Margin="0,0,0,12" />

            <TextBlock Text="Stimme"
                       FontSize="13" FontWeight="Medium"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,0,0,6" />
            <ComboBox Style="{StaticResource DarkComboBox}"
                      ItemsSource="{Binding VoiceChoices}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedVoiceId, Mode=TwoWay}"
                      Margin="0,0,0,12" />

            <Grid Margin="0,0,0,4">
                <TextBlock Text="Sprechtempo"
                           FontSize="13" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondary}" />
                <TextBlock Text="{Binding SpeakingRate, StringFormat={}{0:0.00}x}"
                           FontSize="12"
                           Foreground="{StaticResource TextTertiary}"
                           HorizontalAlignment="Right" />
            </Grid>
            <Slider Minimum="0.7" Maximum="1.6" TickFrequency="0.05" IsSnapToTickEnabled="True"
                    Value="{Binding SpeakingRate, Mode=TwoWay}"
                    Margin="0,0,0,8" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="VoiceTestButton"
                        Grid.Column="0"
                        Content="Stimme testen"
                        Style="{StaticResource TestButton}"
                        Click="VoiceTest_Click" />
                <TextBlock x:Name="VoiceTestResultText"
                           Grid.Column="1"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondary}" />
            </Grid>

            <!-- AssemblyAI (only when chosen) -->
            <StackPanel Visibility="{Binding ShowAssemblyAiKey, Converter={StaticResource BoolToVis}}">
            <!-- AssemblyAI API Key -->
            <Grid Margin="0,0,0,4">
                <TextBlock Text="AssemblyAI-Key"
                           FontSize="13" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" />
                <Button Content="Key holen &#x2192;"
                        Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Right"
                        Click="AssemblyAiLink_Click" />
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="AssemblyAiKeyBox"
                             Grid.Column="0"
                             Style="{StaticResource DarkPasswordBox}"
                             PasswordChanged="AssemblyAiKeyBox_PasswordChanged"
                             Margin="0,0,8,0" />
                <TextBox x:Name="AssemblyAiSavedPlaceholder"
                         Grid.Column="0"
                         Style="{StaticResource DarkTextBox}"
                         Text="&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;"
                         IsReadOnly="True"
                         Margin="0,0,8,0"
                         Visibility="Collapsed" />
                <Button x:Name="AssemblyAiChangeBtn"
                        Grid.Column="1"
                        Content="Ändern"
                        Style="{StaticResource TestButton}"
                        Click="AssemblyAiChange_Click"
                        Visibility="Collapsed"
                        Margin="0,0,8,0" />
                <Button x:Name="AssemblyAiTestBtn"
                        Grid.Column="2"
                        Content="Test"
                        Style="{StaticResource TestButton}"
                        Click="AssemblyAiTest_Click" />
            </Grid>

            <!-- AssemblyAI key error -->
            <TextBlock Text="{Binding AssemblyAiKeyError}"
                       FontSize="11" Foreground="{StaticResource Failure}"
                       Margin="0,0,0,4"
                       Visibility="{Binding AssemblyAiKeyError, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>

            <!-- ElevenLabs (only when chosen) -->
            <StackPanel Visibility="{Binding ShowElevenLabsKey, Converter={StaticResource BoolToVis}}">

            <!-- ElevenLabs API Key -->
            <Grid Margin="0,0,0,4">
                <TextBlock Text="ElevenLabs-Key"
                           FontSize="13" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" />
                <Button Content="Key holen &#x2192;"
                        Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Right"
                        Click="ElevenLabsLink_Click" />
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="ElevenLabsKeyBox"
                             Grid.Column="0"
                             Style="{StaticResource DarkPasswordBox}"
                             PasswordChanged="ElevenLabsKeyBox_PasswordChanged"
                             Margin="0,0,8,0" />
                <TextBox x:Name="ElevenLabsSavedPlaceholder"
                         Grid.Column="0"
                         Style="{StaticResource DarkTextBox}"
                         Text="&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;"
                         IsReadOnly="True"
                         Margin="0,0,8,0"
                         Visibility="Collapsed" />
                <Button x:Name="ElevenLabsChangeBtn"
                        Grid.Column="1"
                        Content="Ändern"
                        Style="{StaticResource TestButton}"
                        Click="ElevenLabsChange_Click"
                        Visibility="Collapsed"
                        Margin="0,0,8,0" />
                <Button x:Name="ElevenLabsTestBtn"
                        Grid.Column="2"
                        Content="Test"
                        Style="{StaticResource TestButton}"
                        Click="ElevenLabsTest_Click" />
            </Grid>

            <!-- ElevenLabs key error -->
            <TextBlock Text="{Binding ElevenLabsKeyError}"
                       FontSize="11" Foreground="{StaticResource Failure}"
                       Margin="0,0,0,4"
                       Visibility="{Binding ElevenLabsKeyError, Converter={StaticResource NullToCollapsed}}" />

            <!-- ElevenLabs Voice ID -->
            <TextBlock Text="ELEVENLABS VOICE-ID"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextTertiary}"
                       Margin="0,0,0,6" />
            <TextBox Style="{StaticResource DarkTextBox}"
                     Text="{Binding ElevenLabsVoiceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,20" />
            </StackPanel>

            <!-- Separator -->
            <Border Height="0.5" Background="{StaticResource BorderSubtle}" Margin="0,0,0,16" />

            <!-- AUDIO DEVICES header -->
            <TextBlock Text="AUDIOGERÄTE"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextTertiary}"
                       Margin="0,0,0,12" />

            <!-- Microphone selector -->
            <TextBlock Text="Mikrofon"
                       FontSize="13" FontWeight="Medium"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,0,0,6" />
            <ComboBox x:Name="MicrophoneCombo"
                      Style="{StaticResource DarkComboBox}"
                      ItemsSource="{Binding MicrophoneDevices}"
                      DisplayMemberPath="FriendlyName"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedMicrophoneDeviceId, Mode=TwoWay}"
                      Margin="0,0,0,12" />

            <!-- Speaker / output selector -->
            <TextBlock Text="Lautsprecher / Kopfhörer"
                       FontSize="13" FontWeight="Medium"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,0,0,6" />
            <ComboBox x:Name="SpeakerCombo"
                      Style="{StaticResource DarkComboBox}"
                      ItemsSource="{Binding SpeakerDevices}"
                      DisplayMemberPath="FriendlyName"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedSpeakerDeviceId, Mode=TwoWay}"
                      Margin="0,0,0,20" />

            <!-- Separator -->
            <Border Height="0.5" Background="{StaticResource BorderSubtle}" Margin="0,0,0,16" />

            <!-- Gamer mode -->
            <TextBlock Text="GAMER-MODUS"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextTertiary}"
                       Margin="0,0,0,12" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Cursor beim Bewegen ausblenden"
                               FontSize="13" FontWeight="Medium"
                               Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="heyDanis bleibt beim Zocken unsichtbar, bis es etwas zu zeigen gibt (dann mit Kreisen und Pfeilen)."
                               FontSize="11"
                               Foreground="{StaticResource TextTertiary}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>
                <CheckBox Grid.Column="1"
                          VerticalAlignment="Center"
                          IsChecked="{Binding GamerModeEnabled, Mode=TwoWay}" />
            </Grid>

            <!-- Separator -->
            <Border Height="0.5" Background="{StaticResource BorderSubtle}" Margin="0,0,0,16" />

            <!-- Buttons -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="heyDanis beenden"
                        Style="{StaticResource SecondaryButton}"
                        Click="Quit_Click" />
                <Button x:Name="SaveButton"
                        Grid.Column="2"
                        Content="Speichern"
                        Style="{StaticResource AccentButton}"
                        IsEnabled="{Binding CanSave}"
                        Click="Save_Click" />
            </Grid>

            <!-- Version -->
            <TextBlock x:Name="VersionText"
                       FontSize="11"
                       Foreground="#888"
                       Margin="0,0,0,4" />

            <!-- Help footnote -->
            <TextBlock Text="Deine Keys werden mit deinem Windows-Konto verschlüsselt und nur auf diesem PC gespeichert. heyDanis lädt sie nirgendwo hoch."
                       FontSize="11"
                       FontStyle="Italic"
                       Foreground="{StaticResource TextTertiary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4" />

        </StackPanel>
    </ScrollViewer>
</Window>
